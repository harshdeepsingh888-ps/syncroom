    "socket.io": "^4.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
