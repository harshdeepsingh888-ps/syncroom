{
  "name": "@syncroom/server",
  "version": "0.1.0",
  "private": true,
  "description": "Server-authoritative real-time backend for SyncRoom.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
